# Token de Hugging Face para WhisperX (Speaker Diarization)
# Para activar la separación por locutores (reconocer quién habla y cuándo),
# necesitas un token de acceso gratuito de Hugging Face.
#
# Pasos para obtenerlo:
# 1. Regístrate o inicia sesión en https://huggingface.co/
# 2. Visita https://huggingface.co/pyannote/speaker-diarization-community-1 y acepta las condiciones de uso (User Agreement).
# 3. Visita https://huggingface.co/settings/tokens y crea un nuevo token. ¡IMPORTANTE!: En "Token type", selecciona la opción "Read".
# 4. Copia el token y pégalo aquí abajo, reemplazando "tu_token_aqui".
# 5. Renombra este archivo de ".env.example" a ".env".
#
# IMPORTANTE SOBRE PRIVACIDAD: El uso de este token es ÚNICAMENTE para autorizar la 
# descarga inicial del modelo a tu disco duro. Ningún fragmento de audio ni texto se 
# sube jamás a la nube. Todo el análisis sigue siendo 100% LOCAL y privado.
#
# Si no proporcionas un token o este archivo no existe, la aplicación seguirá
# transcribiendo perfectamente de forma local, pero no identificará a los diferentes locutores.

HF_TOKEN="tu_token_aqui"

# ---------------------------------------------------------------------------
# API Keys para el Agent Plugin (servidor MCP en agent-plugin/mcp_server.py)
# ---------------------------------------------------------------------------
# La interfaz web NO usa estas variables: allí cada usuario introduce su propia
# API Key en el navegador (se guarda en localStorage, nunca en el servidor).
# Estas variables solo las necesita la tool "analyze_transcription" del MCP
# server, para que un agente de IA (Claude Code, Claude Desktop, Cursor...)
# pueda pedir análisis sin tener que pasar una clave en cada llamada.
#
# Define solo las de los proveedores que vayas a usar desde el MCP server;
# las demás pueden quedar vacías o eliminarse.

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY="tu_api_key_de_gemini_aqui"

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY="tu_api_key_de_openai_aqui"

# Anthropic (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="tu_api_key_de_anthropic_aqui"
