# Configuración del servidor local de Gemma 4 (llama-server)
#
# Este fichero no contiene secretos: Gemma 4 corre 100% en tu máquina, sin
# autenticación ni claves de API. Aun así, cada valor depende de tu hardware
# (VRAM disponible, puerto libre...), así que se trata como configuración
# local por-máquina en vez de un valor único para todo el mundo: copia este
# fichero a ".env" y ajusta lo que necesites.
#
# Tanto gemma4/start_gemma.py (el launcher de llama-server) como
# backend/llm_service.py (el cliente que le envía las peticiones de análisis)
# leen este mismo fichero, así que basta con cambiarlo aquí una vez.

# Host y puerto donde escuchará llama-server.
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# Tamaño de contexto (tokens). Súbelo si tienes VRAM de sobra y necesitas
# analizar transcripciones muy largas; bájalo si te quedas sin memoria.
LLAMA_CTX_SIZE=32768

# Nº de capas del modelo descargadas a GPU. 99 = "todas las que quepan"
# (recomendado con GPU dedicada). Baja este valor o ponlo a 0 si quieres
# forzar la ejecución en CPU.
LLAMA_N_GPU_LAYERS=99

# Flash Attention: más rápido y con menos VRAM en GPUs compatibles (NVIDIA
# serie RTX). Pon "false" si tu GPU no lo soporta y ves errores al arrancar.
LLAMA_FLASH_ATTENTION=true
